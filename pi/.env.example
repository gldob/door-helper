# Kopiere diese Datei nach .env und trage deine Werte ein:
#   cp .env.example .env

# --- ÖV-Abfahrten (OJP 2.0) ---
# API-Key: https://api-manager.opentransportdata.swiss/
OJP_API_KEY=
# DiDok-/BPUIC-Nummer der Haltestelle, z.B. 8503000 = Zürich HB
# Suche: https://opentransportdata.swiss/de/dataset/service-points-full
OJP_STOP_POINT_REF=8503000
OJP_STOP_NAME=Zürich HB
# Optional:
# OJP_API_URL=https://api.opentransportdata.swiss/ojp20
# OJP_REQUESTOR_REF=door-helper
# OJP_NUMBER_OF_RESULTS=10

# --- Wetter (Open-Meteo, kein API-Key nötig) ---
WEATHER_LAT=47.3769
WEATHER_LON=8.5417

# --- Nextbike ---
# Stationen als "uid:Anzeigename", kommagetrennt.
# UIDs findest du in https://maps2.nextbike.net/maps/nextbike-live.json?domains=ch
NEXTBIKE_DOMAIN=ch
NEXTBIKE_STATIONS=12345:Zuhause,67890:Bahnhof
# Station, deren Verfügbarkeit auf dem Home-Screen signalisiert wird (! / X)
NEXTBIKE_HOME_STATION=12345

# --- Abfuhrkalender (optional) ---
# .ics-Datei(en) deines Entsorgers, kommagetrennt (z.B. für den Jahreswechsel).
# Relative Pfade gelten ab dem pi/-Ordner. Leer = Funktion aus.
WASTE_CALENDAR_FILES=data/2026_Gemeinde.ics,data/2027_Gemeinde.ics
# Stunden vor der Abfuhr, ab denen der Hinweis erscheint
# WASTE_LOOKAHEAD_HOURS=15
# Stunden nach der Abfuhr, die der Hinweis noch sichtbar bleibt
# WASTE_AFTER_PICKUP_HOURS=2

# --- System (optional) ---
# TIMEZONE=Europe/Zurich
# WAVESHARE_LIB_PATH=/home/pi/Touch_e-Paper_HAT/python/lib
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# DEBUG für mehr Details (z.B. Touch-Koordinaten)
# LOG_LEVEL=INFO
